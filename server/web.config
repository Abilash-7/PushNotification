<?xml version="1.0" encoding="utf-8"?>

<configuration>

    <system.webServer>

        <!-- ================================================= -->
        <!-- IISNODE HANDLER -->
        <!-- ================================================= -->

        <handlers>

            <add
                name="iisnode"
                path="server.js"
                verb="*"
                modules="iisnode"
            />

        </handlers>


        <!-- ================================================= -->
        <!-- URL REWRITE -->
        <!-- ================================================= -->

        <rewrite>

            <rules>

                <!-- ========================================= -->
                <!-- BLOCK .ENV -->
                <!-- ========================================= -->

                <rule
                    name="BlockEnv"
                    stopProcessing="true">

                    <match
                        url="^\.env$"
                    />

                    <action
                        type="CustomResponse"
                        statusCode="403"
                        statusReason="Forbidden"
                        statusDescription="Forbidden"
                    />

                </rule>


                <!-- ========================================= -->
                <!-- BLOCK PACKAGE LOCK -->
                <!-- ========================================= -->

                <rule
                    name="BlockPackageLock"
                    stopProcessing="true">

                    <match
                        url="^package-lock\.json$"
                    />

                    <action
                        type="CustomResponse"
                        statusCode="403"
                        statusReason="Forbidden"
                        statusDescription="Forbidden"
                    />

                </rule>


                <!-- ========================================= -->
                <!-- NODE.JS APPLICATION -->
                <!-- ========================================= -->

                <rule
                    name="NodeJS"
                    stopProcessing="true">

                    <match
                        url=".*"
                    />

                    <action
                        type="Rewrite"
                        url="server.js"
                    />

                </rule>

            </rules>

        </rewrite>


        <!-- ================================================= -->
        <!-- REQUEST LIMIT -->
        <!-- ================================================= -->

        <security>

            <requestFiltering>

                <requestLimits
                    maxAllowedContentLength="104857600"
                />

            </requestFiltering>

        </security>


        <!-- ================================================= -->
        <!-- IISNODE -->
        <!-- ================================================= -->

        <iisnode
            loggingEnabled="true"
            devErrorsEnabled="true"
        />

    </system.webServer>


    <!-- ===================================================== -->
    <!-- ASP.NET -->
    <!-- ===================================================== -->

    <system.web>

        <compilation
            debug="false"
        />

    </system.web>

</configuration>